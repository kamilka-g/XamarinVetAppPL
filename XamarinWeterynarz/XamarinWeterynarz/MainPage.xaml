<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XamarinWeterynarz.MainPage">

    <StackLayout Spacing="10" BackgroundColor="LightGreen">
        <Label Text="Wizyta u weterynarza" FontSize="Large" BackgroundColor="SeaGreen" Padding="10" ></Label>
        <Entry x:Name="ImieorazNazwisko" Placeholder="Imię i nazwisko właściciela..."></Entry>

        <Label Text="Gatunek"></Label>
        <CollectionView x:Name="Lista" SelectionChanged="ListView_ItemSelected">
        <CollectionView.ItemsSource>
            <x:Array Type="{x:Type x:String}">
                    <x:String>Pies</x:String>
                    <x:String>Kot</x:String>
                    <x:String>Świnka Morska</x:String>
                </x:Array>
            </CollectionView.ItemsSource>
        </CollectionView>

        <StackLayout Orientation="Horizontal" Margin="0">
            <Label Text="Ile ma lat?"></Label>
            <Label x:Name="labelek" Text="0"></Label>
            <Slider  x:Name="slider" Minimum="0" Maximum="20" Value="0" HorizontalOptions="FillAndExpand"  ValueChanged="Slider_ValueChanged"></Slider>
        </StackLayout>

        <Entry x:Name="cel" Placeholder="Cel wizyty"></Entry>
        <TimePicker x:Name="Czas" Time="16:00" ></TimePicker>
        <Button x:Name="przycisk" Text="OK" Clicked="Button_Clicked"></Button>
        <Label x:Name="wypis" Text="" ></Label>
    </StackLayout>
</ContentPage>
